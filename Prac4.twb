      <aliases enabled='yes' />
      <column caption='Profit Margin Ratio' datatype='real' name='[Calculation_0325216747274240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Profit] / [Sales]' />
      </column>
      <column caption='Total Revenue Before Discount' datatype='real' name='[Calculation_0325216748818434]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Sales] * [Quantity]' />
      </column>
      <column caption='Aggregate Profit Margin' datatype='real' name='[Calculation_0325216750055428]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
      </column>
      <column caption='Fixed Regional Sales' datatype='real' name='[Calculation_0325216750858245]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [State] : SUM([Sales]) }' />
      </column>
      <column caption='Include Sales per Customer' datatype='real' name='[Calculation_0325216752189446]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ INCLUDE [Customer ID] : SUM([Sales]) }' />
      </column>
      <column aggregation='Attribute' caption='Exclude Category Sales' datatype='real' name='[Calculation_0325216753074183]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE [Sub-Category] : SUM([Sales]) }' />
      </column>
      <column caption='KPI Threshold Met?' datatype='string' name='[Calculation_0325216755343369]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Profit]) &gt;= [Parameters].[Parameter 0325216753795080] THEN &quot;Target Achieved&quot;&#13;&#10;ELSE &quot;Below Target&quot;&#13;&#10;END' />
      </column>
      <column caption='Cleaned Discount' datatype='real' name='[Calculation_0325216756768778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Discount], 0)' />
      </column>
      <column caption='Standardized City Type' datatype='string' name='[Calculation_0325216757440523]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER([City Type])' />
