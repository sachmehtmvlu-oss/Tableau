      <aliases enabled='yes' />
      <column caption='Physics_Clean' datatype='real' name='[Calculation_1355188411375621]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(FLOAT(REPLACE(STR([Physics]), &apos;%&apos;, &apos;&apos;)), 0)' />
      </column>
      <column caption='Attendance_Clean' datatype='real' name='[Calculation_1355188411752454]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(TRIM(REPLACE(STR([Attendance]), &apos;%&apos;, &apos;&apos;)))' />
      </column>
      <column caption='Math_Clean' datatype='integer' name='[Calculation_1355188413779975]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Math], 0)' />
      </column>
      <column caption='Chemistry_Clean' datatype='integer' name='[Calculation_1355188413927432]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Chemistry], 0)' />
      </column>
      <column caption='Semester' datatype='string' name='[Calculation_1355188419473417]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Table Name], &quot;Sem1&quot;) THEN &quot;Semester 1&quot;&#13;&#10;ELSEIF CONTAINS([Table Name], &quot;Sem2&quot;) THEN &quot;Semester 2&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='Total_Score' datatype='real' name='[Calculation_1355188423135242]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1355188413779975] + [Calculation_1355188411375621] + [Calculation_1355188413927432] + [Programming]' />
      </column>
      <column caption='Overall_Percentage' datatype='real' default-format='p0.00%' name='[Calculation_1355188423397387]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1355188423135242] / 400.0' />
      </column>
      <column caption='Performance_Band' datatype='string' name='[Calculation_1355188423774220]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1355188423397387] &gt;= 0.85 THEN &quot;Distinction&quot;&#13;&#10;ELSEIF [Calculation_1355188423397387] &gt;= 0.75 THEN &quot;First Class&quot;&#13;&#10;ELSEIF [Calculation_1355188423397387] &gt;= 0.60 THEN &quot;Second Class&quot;&#13;&#10;ELSE &quot;Needs Academic Support&quot;&#13;&#10;END' />
      </column>
      <column caption='Attendance_Status' datatype='string' name='[Calculation_1355188424687629]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1355188411752454] &gt;= 75 THEN &quot;Eligible (Good Standing)&quot;&#13;&#10;ELSE &quot;Shortage Warning (&lt;75%)&quot;&#13;&#10;END' />
      </column>
      <column caption='Dept_Average_Percentage_LOD' datatype='real' default-format='p0.0%' name='[Calculation_1355188425601038]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Dept_Info] : AVG([Calculation_1355188423397387]) }' />
      </column>
      <column caption='Student_Overall_Career_Average' datatype='real' default-format='p0.0%' name='[Calculation_1355188426133519]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Student_ID] : AVG([Calculation_1355188423397387]) }' />
      </column>
      <column caption='Variance_From_Dept_Average' datatype='real' default-format='p0.0%' name='[Calculation_1355188426645520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1355188423397387] - [Calculation_1355188425601038]' />
      </column>
      <column caption='Benchmark_Status' datatype='string' name='[Calculation_1355188426948625]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1355188426645520] &gt;= 0 THEN &quot;Above Department Benchmark&quot;&#13;&#10;ELSE &quot;Below Department Benchmark&quot;&#13;&#10;END' />
      </column>
      <column caption='Full_Name_Clean' datatype='string' name='[Calculation_1355188428132370]' role='dimension' type='nominal'>
